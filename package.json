{
  "name": "client-web-api-sandbox",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": "11.19.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format",
    "format:fix": "biome format --write",
    "markup": "markuplint \"src/**/*.{jsx,tsx,html}\"",
    "markup:fix": "markuplint \"src/**/*.{jsx,tsx,html}\" --fix",
    "check-biome": "biome check",
    "check-biome:fix": "biome check --write",
    "check": "npm run markup && npm run check-biome",
    "check:fix": "npm run markup:fix && npm run check-biome:fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --watchAll=false",
    "inspector:samples": "node src/encoder-capability-inspector/scripts/generateSyntheticSamples.ts",
    "inspector:samples:check": "node src/encoder-capability-inspector/scripts/generateSyntheticSamples.ts --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-tree-view": "^9.14.0",
    "@okathira/ghostpdl-wasm": "^1.1.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@xmldom/xmldom": "^0.9.12",
    "fast-xml-parser": "^5.11.2",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jotai": "^3.0.1",
    "mediabunny": "^1.61.1",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-xml-viewer": "^3.0.5",
    "three": "^0.186.1",
    "tone": "^15.5.44",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@markuplint/jsx-parser": "^5.0.1",
    "@markuplint/react-spec": "^5.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/dom-mediacapture-transform": "^0.1.12",
    "@types/emscripten": "^1.41.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "markuplint": "^5.0.1",
    "ts-jest": "^29.4.14",
    "ts-jest-mock-import-meta": "^1.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  },
  "lint-staged": {
    "*.{jsx,tsx,html}": [
      "markuplint"
    ],
    "src/**/*.{js,jsx,ts,tsx,json,css,html}": [
      "biome check"
    ]
  },
  "volta": {
    "node": "24.21.0",
    "npm": "11.19.0"
  }
}
