# Public browser OAuth Client ID only; Vite exposes VITE_* in the built JavaScript.
# Never place a client secret, access token, refresh token, or password here.
# Google Drive backup only. This public browser client ID is intentionally not a secret.
VITE_BUSYBOX_DRIVE_GOOGLE_CLIENT_ID=
# Public browser client ID for the separate Google FedCM stage.
VITE_BUSYBOX_FEDCM_GOOGLE_CLIENT_ID=
